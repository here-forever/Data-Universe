# Application
APP_NAME="Vibe Data Universe"
APP_ENV=development
APP_DEBUG=true

# Backend HTTP
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Workspace metadata and local files
DATABASE_URL=sqlite+pysqlite:///./storage/vibe-data.db
DATA_STORAGE_ROOT=./storage/datasets
EXPORT_STORAGE_ROOT=./storage/exports

# File and rendering limits
UPLOAD_MAX_BYTES=134217728
DATASET_MAX_ROWS=500000
DATASET_MAX_COLUMNS=300
PREVIEW_ROWS=30
PARTICLE_SAMPLE_ROWS=1500

# Optional external data narrator. Leave LLM_API_KEY empty for the local statistical engine.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_API_STYLE=responses
LLM_TIMEOUT_SECONDS=30

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api
